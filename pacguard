#!/usr/bin/env python3
import subprocess
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path
import sys
from rich.console import Console
from rich.panel import Panel

console = Console()

def get_pending_updates():
    """checkupdates_no_root"""
    try:
        res = subprocess.run(["checkupdates"], capture_output=True, text=True, check=True)
        pkgs = [line.split()[0] for line in res.stdout.strip().split("\n") if line]
        return pkgs
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []

def get_arch_news():
    """fetch_archnews_timeout_2s"""
    url = "https://archlinux.org/feeds/news/"
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'PacGuard/1.0'})
        with urllib.request.urlopen(req, timeout=2.0) as response:
            tree = ET.fromstring(response.read())
            items = []
            for item in tree.findall('.//item')[:5]:  #recent_news
                items.append({
                    'title': item.find('title').text,
                    'link': item.find('link').text
                })
            return items
    except Exception:
        return []

def main():
    pending = get_pending_updates()
    news = get_arch_news()
    
    matches = []
    for item in news:
        for pkg in pending:
            if pkg in item['title'].lower().split():
                matches.append((pkg, item))

    #dashboard
    console.print(Panel(f"[bold green]Pending Repo Updates:[/bold green] {len(pending)}"))
    
    if matches:
        console.print("[bold red]Match found in Arch news.:[/bold red]")
        for pkg, item in matches:
            console.print(f" • [bold yellow]{pkg}[/bold yellow] affected by: {item['title']}")
            console.print(f"   [dim]{item['link']}[/dim]")
        
        confirm = input("\nProceed with upgrade anyway? [y/N]: ")
        if confirm.lower() != 'y':
            sys.exit(1)
    
    #back_to_pacman
    subprocess.run(["sudo", "pacman", "-Syu"])

if __name__ == "__main__":
    main()